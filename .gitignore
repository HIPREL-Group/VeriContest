# Local external dependency checkout. See benchmarks/verus/post2exe/EXTERNAL_DEPS.md.
benchmarks/verus/post2exe/tree-sitter-verus/

# Python caches and generated local artifacts.
__pycache__/
*.py[cod]

# Local secrets. The LeetCode submission script reads LEETCODE_SESSION /
# LEETCODE_CSRF_TOKEN from a .env at the repo root; never commit it.
.env
.env.*

# Build outputs that should not be committed.
target/
build/
*.so
*.o
*.rlib

# Per-problem test sources are versioned; generated datasets and binaries are not.
/benchmarks/verus/problems/**/tests/*
!/benchmarks/verus/problems/**/tests/*.rs
!/benchmarks/verus/problems/**/tests/checker.py
!/benchmarks/verus/problems/**/tests/README.md

# Exception: the bundled Verus toolchain ships prebuilt runtime libraries that
# benchmarks/verus/toolchain/verus needs to run. Keep them tracked.
!benchmarks/verus/toolchain/*.so
!benchmarks/verus/toolchain/*.rlib

spec_validation/

# Evaluation: tools built by benchmarks/verus/evaluation/setup_tools.sh and local run outputs.
benchmarks/verus/evaluation/tools/
benchmarks/verus/evaluation/runs/
