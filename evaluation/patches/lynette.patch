+/// `Ghost(e)` / `Tracked(e)`: the verus macro checks `e` in ghost mode and
+/// erases the wrapper, so it has no executable effect.
+fn is_ghost_wrapper(expr: &syn_verus::Expr) -> bool {
+    match expr {
+        syn_verus::Expr::Call(c) => matches!(
+            &*c.func,
+            syn_verus::Expr::Path(p) if p.qself.is_none()
+                && (p.path.is_ident("Ghost") || p.path.is_ident("Tracked"))
+        ),
+        _ => false,
     }
 }
 
