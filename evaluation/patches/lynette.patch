+struct Deghost<'a> {
+    mode: &'a DeghostMode,
+}
+
+impl<'a> VisitMut for Deghost<'a> {
+    fn visit_block_mut(&mut self, b: &mut syn_verus::Block) {
+        let mode = self.mode;
+        b.stmts.retain(|s| !is_ghost_stmt(s, mode));
+        for s in b.stmts.iter_mut() {
+            self.visit_stmt_mut(s);
+        }
+        b.stmts.retain(|s| match s {
+            syn_verus::Stmt::Expr(e) | syn_verus::Stmt::Semi(e, _) => !is_noop_if(e),
+            _ => true,
+        });
+    }
+
+    fn visit_expr_if_mut(&mut self, i: &mut syn_verus::ExprIf) {
+        visit_mut::visit_expr_if_mut(self, i);
+        let drop_else = match &i.else_branch {
+            Some((_, e)) => is_empty_block_expr(e) || is_noop_if(e),
+            None => false,
+        };
+        if drop_else {
+            i.else_branch = None;
+        }
+    }
+
+    fn visit_expr_while_mut(&mut self, w: &mut syn_verus::ExprWhile) {
+        w.attrs.retain(|a| !is_loop_isolation_attr(a));
+        w.invariant_except_break = None;
+        w.invariant = None;
+        w.invariant_ensures = None;
+        w.ensures = None;
+        w.decreases = None;
+        visit_mut::visit_expr_while_mut(self, w);
+    }
+
+    fn visit_expr_for_loop_mut(&mut self, f: &mut syn_verus::ExprForLoop) {
+        f.attrs.retain(|a| !is_loop_isolation_attr(a));
+        f.invariant = None;
+        f.decreases = None;
+        visit_mut::visit_expr_for_loop_mut(self, f);
+    }
+
+    fn visit_expr_loop_mut(&mut self, l: &mut syn_verus::ExprLoop) {
+        l.attrs.retain(|a| !is_loop_isolation_attr(a));
+        l.invariant_except_break = None;
+        l.invariant = None;
+        l.invariant_ensures = None;
+        l.ensures = None;
+        l.decreases = None;
+        visit_mut::visit_expr_loop_mut(self, l);
+    }
+
+    fn visit_expr_closure_mut(&mut self, c: &mut syn_verus::ExprClosure) {
+        if !self.mode.requires {
+            c.requires = None;
+        }
+        if !self.mode.ensures {
+            c.ensures = None;
+        }
+        visit_mut::visit_expr_closure_mut(self, c);
+    }
+}
+
+/// Inside a spec fn: removes proof statements (`proof { }`, assert, assume,
+/// reveal) -- e.g. termination proofs of a recursive spec fn -- and nothing
+/// else; every expression that gives the spec fn its value stays.
+struct SpecProofStrip;
+
+impl VisitMut for SpecProofStrip {
+    fn visit_block_mut(&mut self, b: &mut syn_verus::Block) {
+        b.stmts.retain(|s| match s {
+            syn_verus::Stmt::Semi(e, _) | syn_verus::Stmt::Expr(e) => !matches!(
+                e,
+                syn_verus::Expr::Assert(..)
+                    | syn_verus::Expr::Assume(..)
+                    | syn_verus::Expr::AssertForall(..)
+                    | syn_verus::Expr::RevealHide(..)
+            ) && !matches!(e, syn_verus::Expr::Unary(u) if matches!(u.op, syn_verus::UnOp::Proof(_))),
+            _ => true,
+        });
+        visit_mut::visit_block_mut(self, b);
+    }
+}
+
+fn strip_spec_fn_proofs(block: &syn_verus::Block) -> syn_verus::Block {
+    let mut b = block.clone();
+    SpecProofStrip.visit_block_mut(&mut b);
+    b
+}
+
+/// Termination-proof parts of a spec fn's `decreases`: `via lemma` only
+/// proves termination, and `when c` only weakens the fn's defining axiom to
+/// `c ==> f(..) == body`, which the original fn still satisfies, so whatever
+/// is proved still holds for the original spec. The measure stays.
+fn strip_spec_fn_termination(sig: &mut syn_verus::Signature) {
+    if let Some(d) = sig.decreases.as_mut() {
+        d.when = None;
+        d.via = None;
+    }
+}
+
+fn deghost_block(block: &syn_verus::Block, mode: &DeghostMode) -> syn_verus::Block {
+    let mut b = block.clone();
+    Deghost { mode }.visit_block_mut(&mut b);
+    b
+}
+
+fn is_spec_mode(mode: &syn_verus::FnMode) -> bool {
+    matches!(mode, syn_verus::FnMode::Spec(_) | syn_verus::FnMode::SpecChecked(_))
 }
 
