+/// Deghosts a module's items; a `verus! { .. }` nested in the module is
+/// expanded in place (only top-level `verus!` macros are extracted elsewhere).
+fn deghost_items(items: &[syn_verus::Item], mode: &DeghostMode) -> Vec<syn_verus::Item> {
+    let mut out = Vec::new();
+    for item in items {
+        if let syn_verus::Item::Macro(m) = item {
+            if is_verus_macro(&m.mac) {
+                if let Ok(inner) = syn_verus::parse2::<syn_verus::File>(m.mac.tokens.clone()) {
+                    out.extend(deghost_items(&inner.items, mode));
+                    continue;
+                }
+            }
+        }
+        if let Some(new_item) = remove_ghost_item(item, mode) {
+            out.push(new_item);
+        }
+    }
+    out
+}
