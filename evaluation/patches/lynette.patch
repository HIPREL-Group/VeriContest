+/*
+ * Ghost-code removal for `lynette compare`.
+ *
+ * Only ghost code is removed: assert / assume / reveal statements, `proof { }`
+ * blocks, ghost and tracked lets (also `let x = Ghost(..)` / `Tracked(..)`),
+ * proof fns, broadcast items, loop invariants / decreases / ensures /
+ * `loop_isolation` attributes, the `via` / `when` of a spec fn's `decreases` and,
+ * per mode, fn specs. Executable structure is kept: an
+ * `if`, loop, match arm or fn whose body held only ghost code stays, with an
+ * empty body. (The previous version dropped such constructs, so exec code next
+ * to them, e.g. the then-branch of `if c { x = 1; } else { proof { .. } }`, was
+ * never compared, while a candidate that left out the ghost-only `else` was
+ * reported as different.)
+ *
+ * Normalizations, applied to both files: an empty `else {}` equals no `else`;
+ * an `if` with an empty body, no `else` and no call in its condition equals no
+ * `if`; lint / doc / verifier attributes and `use vstd::..` imports are ignored.
+ */
+
+fn is_assert_kept(a: &syn_verus::Assert, mode: &DeghostMode) -> bool {
+    mode.asserts
+        || (mode.asserts_anno
+            && a.attrs.iter().any(|attr| attr.tokens.to_string() == "(llm_do_not_change)"))
 }
 
